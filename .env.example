# Public RPCs are for bring-up only. Live watch needs a paid/stable RPC
# (Helius, QuickNode, or equivalent). Rate-limited public endpoints will
# produce UNKNOWN checks, never invented PASS.

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WSS_URL=wss://api.mainnet-beta.solana.com
BASE_RPC_URL=https://mainnet.base.org
BASE_WSS_URL=
ROBINHOOD_RPC_URL=
ROBINHOOD_WSS_URL=

# Robinhood / Pons V2 stays off until factory addresses are verified on-chain.
ROBINHOOD_ENABLED=0

RUGCHECK_ENABLED=0
RUGCHECK_API_URL=
SOLANA_WATCH_POLL_SECONDS=5
# Pause between Solana watch getTransaction calls (milliseconds). Default 50.
SOLANA_WATCH_TX_DELAY_MS=50
GOPLUS_API_KEY=
XAI_API_KEY=
EXPLAIN_ENABLED=0
EXPLAIN_MODEL=grok-4-1-fast
DATA_DIR=./data
